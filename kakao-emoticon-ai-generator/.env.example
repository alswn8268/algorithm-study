# 사용할 이미지 생성 백엔드: mock | dalle | stable_diffusion
KAKAO_EMOTICON_BACKEND=mock

# --- dalle 백엔드 ---
OPENAI_API_KEY=

# --- stable_diffusion 백엔드 ---
SD_MODEL_ID=runwayml/stable-diffusion-v1-5
SD_DEVICE=cuda
# cuda | cpu | mps

# 출력 경로
KAKAO_EMOTICON_OUTPUT_DIR=output

# 카카오 규격 프로필 (kakao_spec.py의 SUBMISSION_PROFILES 참고)
KAKAO_EMOTICON_PROFILE=proposal_static
